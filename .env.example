# Named HOST_UID/HOST_GID, not UID/GID: zsh (macOS's default shell) treats
# UID/GID as special read-only parameters tied to the real process identity,
# so `GID=1000 docker compose build` fails with "failed to change group ID:
# operation not permitted" under zsh. Copy this file to .env (or export
# these two vars in your shell session) before running docker compose.
HOST_UID=501
# GID intentionally NOT set to the host's GID (macOS "staff" = 20 collides
# with Ubuntu's "dialout" = 20 and breaks the container build). Leave this
# at 1000 unless you know what you're doing — see docker-compose.yml.
HOST_GID=1000
